FIREBASE_PROJECT_ID=demo-alaia
# 8081 y no 8080: en esta máquina el 8080 lo usa Evolution API (bot de WhatsApp).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
API_PORT=3001
ALLOWED_WEB_ORIGINS=http://localhost:5173

# --- Agente configurable (ver docs/corte-agente-configurable.md) ---
# Proveedor y modelo por defecto; cada negocio puede cambiarlo desde el panel.
AGENT_PROVIDER_DEFAULT=deepseek
AGENT_MODEL_DEFAULT=deepseek-chat
# Claves: solo hacen falta las de los proveedores que se vayan a usar.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modelos ofrecidos por proveedor (coma-separados). Vacío = defaults del código.
AGENT_MODELS_DEEPSEEK=deepseek-chat,deepseek-reasoner
AGENT_MODELS_OPENAI=
AGENT_MODELS_ANTHROPIC=
AGENT_MODELS_GEMINI=
# Solo desarrollo: habilita el proveedor determinista `mock` para pruebas.
AGENT_ENABLE_MOCK=true

# Panel de plataforma (superadmin de ALAIA). Correos separados por comas.
PLATFORM_ADMIN_EMAILS=
# Clave de cifrado de las claves de proveedores: exactamente 64 caracteres hex.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_SECRET=
# Días de prueba que recibe cada negocio nuevo.
TRIAL_DAYS=14

# WhatsApp Cloud API
WHATSAPP_MODE=off
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v23.0

# Panel: proyecto Firebase real (vacío = emulador local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=

# Secreto para el disparador de recordatorios (cron externo)
CRON_SECRET=
