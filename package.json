{
  "name": "alaia-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm --workspace @alaia/api run dev",
    "start:api": "npm --workspace @alaia/api run start",
    "dev:web": "npm --workspace @alaia/web run dev",
    "build:web": "npm --workspace @alaia/web run build",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-alaia",
    "verify": "node scripts/verify-slice.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "firebase-tools": "15.34.2"
  }
}
